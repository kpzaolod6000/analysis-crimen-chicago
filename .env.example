# =============================================================================
# Chicago Crimes Analytics — variables de entorno (DESARROLLO LOCAL)
# Copia este archivo a `.env` y ajusta si hace falta. `.env` NUNCA se commitea.
#   PowerShell:  copy .env.example .env
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
# Credenciales solo para desarrollo local. No reutilizar en producción.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chicago_crimes
POSTGRES_PORT=5432

# --- n8n --------------------------------------------------------------------
N8N_PORT=5673
# Zona horaria LOCAL del operador (Perú) para los Schedule Triggers de n8n:
# un workflow programado "lunes 08:00" se dispara a las 08:00 de Lima.
# OJO: esto NO cambia los timestamps de los crímenes, que vienen en hora de
# Chicago desde Socrata y se guardan/analizan tal cual en PostgreSQL.
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima

# --- Dashboard ---------------------------------------------------------------
E2E_BASE_URL = http://localhost:5174
